{
  "name": "dsh-planner-executor-loop",
  "version": "0.3.0",
  "description": "规划-执行循环：规划大模型制定计划并下达任务，执行大模型（子代理）落地执行，结果回传由规划者循环评判，最终由规划者判定完工。Planner-executor loop for DeepSeek Harness.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheNewWorldKami/dsh-planner-executor-loop.git"
  },
  "homepage": "https://github.com/TheNewWorldKami/dsh-planner-executor-loop#readme",
  "bugs": {
    "url": "https://github.com/TheNewWorldKami/dsh-planner-executor-loop/issues"
  },
  "author": "dsh-planner-executor-loop contributors",
  "peerDependencies": {
    "@deepseek-ai/cosmokit": "^1.8.4",
    "@deepseek-ai/dsh-llm": ">=0.1.7-rc.1 <0.1.8-0 || >=0.1.8-rc.1 <0.2.0-0",
    "@deepseek-ai/dsh-tools": ">=0.1.7-rc.1 <0.1.8-0 || >=0.1.8-rc.1 <0.2.0-0",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "planner",
    "executor",
    "multi-model",
    "agent-loop"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  }
}
